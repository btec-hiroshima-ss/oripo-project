# このファイルを参考に環境に応じてコピーして使用してください
# ローカル開発: cp .env.example .env
# 本番:         cp .env.example .env.production

# ============================================================
# ローカル開発用（.env）
# ============================================================

# GitHub Personal Access Token（docker-compose.yml の GH_TOKEN に使用）
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxx

# Git ユーザー設定（claudeコンテナ内の git config に反映）
GIT_USER_NAME=your_name
GIT_USER_EMAIL=your_email@example.com

# Claude Code バージョン（省略時は latest）
# CLAUDE_CODE_VERSION=latest
# GIT_DELTA_VERSION=0.18.2
# ZSH_IN_DOCKER_VERSION=1.2.0

# ============================================================
# 本番用（.env.production）
# ============================================================

# GHCR 認証（read:packages スコープの PAT）
# GHCR_USER=GitHubユーザー名
# GHCR_TOKEN=ghp_xxxxxxxxxxxx

# データベース
# DB_USER=oripo
# DB_PASSWORD=パスワードを設定してください
# DB_NAME=oripo
# DATABASE_URL=postgres://oripo:パスワードを設定してください@db:5432/oripo

# アプリ
# NEXT_PUBLIC_APP_URL=https://your-domain.com
