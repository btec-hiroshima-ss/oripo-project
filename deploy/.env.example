# このファイルをコピーして .env.production を作成してください
# .env.production は git 管理対象外です

# GHCR 認証（read:packages スコープの PAT）
GHCR_USER=GitHubユーザー名
GHCR_TOKEN=ghp_xxxxxxxxxxxx

# データベース
DB_USER=oripo
DB_PASSWORD=パスワードを設定してください
DB_NAME=oripo
DATABASE_URL=postgres://oripo:パスワードを設定してください@db:5432/oripo

# アプリ
# NEXT_PUBLIC_APP_URL=https://your-domain.com
